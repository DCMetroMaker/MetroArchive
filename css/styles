* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background-color: #f4f4f4;
}

/* ===== HEADER ===== */
header {
    width: 100%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
}

/* ===== TOP TITLE BAR ===== */
.top-bar {
    background-color: #cdcfcfff;
    padding: 0.65vw 2vw;
    border-bottom: 1px solid #b6b8b8;
}

.site-title {
    color: black;
    font-size: clamp(1.5rem, 2.2vw, 2.3rem);
    font-weight: bold;
}

/* ===== NAVIGATION BAR ===== */
nav {
    width: 100%;
    background-color: #422c24ff;
}

.nav-menu {
    display: flex;
    list-style: none;
    width: 100%;
}

.nav-item {
    position: relative;
    flex: 1;
}

.nav-item > a {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    color: white;
    text-decoration: none;

    padding: 0.58vw 0.2vw;

    font-size: clamp(0.82rem, 1.08vw, 1.08rem);
    font-weight: 700;

    white-space: nowrap;

    transition:
        background-color 0.2s ease,
        color 0.2s ease;
}

.nav-item > a:hover,
.nav-item:hover > a {
    background-color: #6a473b;
    color: #fff0e8;
}

/* ===== DROPDOWNS ===== */
.dropdown,
.submenu {
    list-style: none;
}

.dropdown {
    position: absolute;
    top: 100%;
    left: 0;

    width: 100%;

    background-color: #422c24ff;

    display: none;
    flex-direction: column;

    z-index: 1000;
}

.dropdown li {
    position: relative;
}

.dropdown a,
.submenu a {
    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    color: white;
    text-decoration: none;

    padding: 0.72vw 0.5vw;

    font-size: clamp(0.72rem, 0.95vw, 0.95rem);
    font-weight: 600;

    border-top: 1px solid rgba(255,255,255,0.08);

    transition:
        background-color 0.2s ease,
        color 0.2s ease;
}

.dropdown a:hover,
.submenu a:hover,
.has-submenu:hover > a {
    background-color: #6a473b;
    color: #fff0e8;
}

.nav-item:hover > .dropdown {
    display: flex;
}

/* ===== SECOND LEVEL ===== */
.submenu {
    position: absolute;
    top: 0;
    left: 100%;
    width: 100%;
    background-color: #422c24ff;
    display: none;
    z-index: 1100;
}

.has-submenu:hover > .submenu {
    display: block;
}

/* ===== LOWER STRIP ===== */
.bottom-strip {
    width: 100%;
    background-color: #cdcfcfff;

    height: 0.9vw;
    min-height: 6px;
    max-height: 12px;

    border-top: 1px solid #b6b8b8;
}

main {
    padding: 40px;
}
